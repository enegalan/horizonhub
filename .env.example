APP_NAME="Horizon Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=horizonhub
# DB_USERNAME=horizonhub
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Alternative cache stores:
# memcached
# MEMCACHED_HOST=127.0.0.1
# or redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail: "log" writes to storage/logs; use "smtp" for real delivery (alert emails).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Real delivery (SMTP): copy to .env and set your provider's values, then MAIL_MAILER=smtp
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mark services as offline when no events received for this many minutes
# HORIZON_HUB_STALE_SERVICE_MINUTES=5
# HORIZON_HUB_DEAD_SERVICE_MINUTES=15

# Hot reload: interval in seconds for SSE push (refresh stream)
# HORIZON_HUB_HOT_RELOAD_INTERVAL=0.5

# Client TLS (mTLS): directory where uploaded service certificates are stored,
# under the private local disk (storage/app/private). Persist or encrypt that
# directory; it cannot be moved to another disk.
# HORIZON_HUB_TLS_ROOT=service-tls
